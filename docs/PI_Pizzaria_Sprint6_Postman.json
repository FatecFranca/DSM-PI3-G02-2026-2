{
  "info": {
    "name": "PI Pizzaria - Sprint 6 - Checklist APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Modelo de testes manuais. Substituir IDs e capturar token após login; rodar com contas de funcionário e administrador."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "pedidoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Login - obter token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"matricula\": \"SUA_MATRICULA\",\n  \"senha\": \"SUA_SENHA\"\n}"
        }
      }
    },
    {
      "name": "Consultar colaboradores - admin",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/colaboradores",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "colaboradores"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Clientes - pesquisa",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/clientes/busca?termo=Maria",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "clientes",
            "busca"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Produtos - catálogo",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/produtos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "produtos"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Preços oficiais",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/pedidos/precos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "pedidos",
            "precos"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Taxa de entrega",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/pedidos/taxa-entrega",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "pedidos",
            "taxa-entrega"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Criar pedido de retirada",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/pedidos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "pedidos"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clienteId\": \"SUBSTITUIR_ID\",\n  \"itens\": [\n    {\n      \"produtoId\": \"SUBSTITUIR_ID\",\n      \"quantidade\": 1\n    }\n  ],\n  \"modalidade\": \"RETIRADA\",\n  \"formaPagamento\": \"DINHEIRO\",\n  \"telefoneContato\": \"16999999999\"\n}"
        }
      }
    },
    {
      "name": "Listar pedidos abertos",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/pedidos/abertos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "pedidos",
            "abertos"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Finalizar pedido",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/pedidos/{{pedidoId}}/finalizar",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "pedidos",
            "{{pedidoId}}",
            "finalizar"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Alterar pedido - somente admin",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/pedidos/admin/{{pedidoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "pedidos",
            "admin",
            "{{pedidoId}}"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clienteId\": \"SUBSTITUIR_ID\",\n  \"itens\": [\n    {\n      \"produtoId\": \"SUBSTITUIR_ID\",\n      \"quantidade\": 1\n    }\n  ],\n  \"modalidade\": \"RETIRADA\",\n  \"formaPagamento\": \"PIX\",\n  \"telefoneContato\": \"16999999999\"\n}"
        }
      }
    },
    {
      "name": "Auditoria - somente admin",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/auditoria",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auditoria"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Auditoria com filtro",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/auditoria?termo=PEDIDO",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auditoria"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Redefinir senha - somente admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/admin/redefinir-senha",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "admin",
            "redefinir-senha"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"colaboradorId\": \"SUBSTITUIR_ID\",\n  \"novaSenha\": \"TROCAR_POR_SENHA_SEGURA\"\n}"
        }
      }
    },
    {
      "name": "Excluir pedido - somente admin",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/pedidos/admin/{{pedidoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "pedidos",
            "admin",
            "{{pedidoId}}"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    }
  ]
}